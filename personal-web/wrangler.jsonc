{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viiversion-personal-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "MAX_CRAWL_PAGES": "8",
    "ENABLE_INTERACT": "false",
    "ALLOWED_HOSTS": "viiversion.com,*.viiversion.com",
    "ENABLE_SAVED_SESSIONS": "true",
    "ENABLE_OAUTH": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULT",
        "class_name": "PersonalWebVault"
      },
      {
        "name": "OAUTH",
        "class_name": "PersonalWebOAuth"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PersonalWebVault"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PersonalWebOAuth"
      ]
    }
  ]
}
