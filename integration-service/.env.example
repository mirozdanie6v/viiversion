# Bókun Custom App credentials from Partner Dashboard.
BOKUN_APP_API_KEY=
BOKUN_APP_API_SECRET=

# Random high-entropy secret used to encrypt OAuth and REST credentials at rest.
DATA_ENCRYPTION_KEY=

# Protects VIIVERSION-only administrative endpoints.
INTEGRATION_ADMIN_TOKEN=

BOKUN_ALLOWED_VENDOR_IDS=137689
BOKUN_DEFAULT_VENDOR_ID=137689
BOKUN_DEFAULT_PRODUCT_ID=1287578
BOKUN_DEFAULT_PRODUCT_CODE=5690738P8
BOKUN_PRODUCT_IDS=1287578,1287580
BOKUN_PRODUCT_CODES=5690738P8,5690738P7
BOKUN_REDIRECT_URI=https://integration.viiversion.com/bokun/callback
BOKUN_SCOPES=LEGACY_API
BOKUN_VENDOR_HOST_SUFFIX=bokun.io
BOKUN_REST_BASE_URL=https://api.bokun.io
# Safety gate: keep false until the customer-approved live reservation test.
BOKUN_REAL_BOOKING_ENABLED=false
ALLOWED_ORIGIN_SUFFIX=.viiversion.com


# Meta WhatsApp Cloud API. Keep all values server-side.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Meta Embedded Signup / WhatsApp Coexistence.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Short-lived secure Meta setup page. Production values are generated by deploy workflow.
META_SETUP_TOKEN=
META_SETUP_EXPIRES_AT=
