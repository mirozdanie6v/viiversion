{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "landing",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEADS",
        "class_name": "LeadStore"
      }
    ]
  },
  "exports": {
    "LeadStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}