{
  "name": "max-tour-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:list:local": "wrangler d1 migrations list DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/verified-max-tour.sql",
    "db:create:production": "wrangler d1 create max-tour-production",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote",
    "db:seed:production": "wrangler d1 execute DB --remote --file=seed/verified-max-tour.sql",
    "check:production-config": "node scripts/check-production-config.mjs",
    "deploy": "npm run check:production-config && wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^26.5.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  }
}
